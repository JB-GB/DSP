options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fm_rx_archivo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FM RX archivo IQ
    window_size: (1200,900)
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [8, 8], rotation: 0, state: enabled}

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'fs de RF; 1.2 Msps es estable en RTL-SDR y divisible a 240k/48k'
    value: '1200000'
  states: {coordinate: [200, 12], rotation: 0, state: enabled}
- name: mpx_rate
  id: variable
  parameters:
    comment: 'fs tras decimar el canal (samp_rate/5)'
    value: samp_rate//5
  states: {coordinate: [320, 12], rotation: 0, state: enabled}
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states: {coordinate: [440, 12], rotation: 0, state: enabled}
- name: fm_dev
  id: variable
  parameters:
    comment: 'desviacion maxima FM comercial (Hz)'
    value: '75000'
  states: {coordinate: [560, 12], rotation: 0, state: enabled}
- name: import_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states: {coordinate: [680, 12], rotation: 0, state: enabled}
- name: center_freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Frecuencia central (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '88000000'
    step: '100000'
    stop: '108000000'
    value: '89700000'
    widget: counter_slider
  states: {coordinate: [800, 12], rotation: 0, state: enabled}
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Ganancia RF (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '30'
    widget: counter_slider
  states: {coordinate: [800, 12], rotation: 0, state: enabled}
- name: src
  id: blocks_file_source
  parameters:
    comment: 'Reproduce una captura .cfile (p. ej. la sintetica de fm_synth.py) sin hardware'
    file: synth_fm.cfile
    length: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states: {coordinate: [180, 200], rotation: 0, state: enabled}
- name: throttle
  id: blocks_throttle
  parameters:
    comment: 'Sin hardware no hay reloj: el throttle impone samp_rate'
    ignoretag: 'True'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states: {coordinate: [180, 300], rotation: 0, state: enabled}
- name: channel_lpf
  id: low_pass_filter
  parameters:
    beta: '6.76'
    comment: 'Aisla el canal FM de 200 kHz: corte 100k, transicion 50k (Kaiser). Decim 5'
    cutoff_freq: '100000'
    decim: '5'
    gain: '1'
    interp: '1'
    samp_rate: samp_rate
    type: fir_filter_ccf
    width: '50000'
    win: window.WIN_KAISER
  states: {coordinate: [420, 260], rotation: 0, state: enabled}
- name: quad_demod
  id: analog_quadrature_demod_cf
  parameters:
    comment: 'gain = fs/(2*pi*dev): normaliza la desviacion maxima a +-1'
    gain: mpx_rate/(2*math.pi*fm_dev)
  states: {coordinate: [640, 260], rotation: 0, state: enabled}
- name: deemph
  id: analog_fm_deemph
  parameters:
    comment: 'De-enfasis 75 us (America)'
    samp_rate: mpx_rate
    tau: 75e-6
  states: {coordinate: [860, 260], rotation: 0, state: enabled}
- name: audio_lpf
  id: low_pass_filter
  parameters:
    beta: '6.76'
    comment: 'Audio 15 kHz; transicion 4 kHz rechaza el piloto de 19 kHz. Decim 5 -> 48 kHz'
    cutoff_freq: '15000'
    decim: '5'
    gain: '1'
    interp: '1'
    samp_rate: mpx_rate
    type: fir_filter_fff
    width: '4000'
    win: window.WIN_KAISER
  states: {coordinate: [1060, 260], rotation: 0, state: enabled}
- name: audio_out
  id: audio_sink
  parameters:
    comment: ''
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: audio_rate
  states: {coordinate: [1260, 240], rotation: 0, state: enabled}
- name: audio_file
  id: blocks_wavfile_sink
  parameters:
    comment: 'Muestra de audio para results/audio_samples'
    file: audio_mono_48k.wav
    nchan: '1'
    samp_rate: audio_rate
    type: float
    format: FORMAT_WAV
    subformat: FORMAT_PCM_16
    append: 'False'
    bits_per_sample1: FORMAT_PCM_16
  states: {coordinate: [1260, 340], rotation: 0, state: enabled}
- name: mpx_sink
  id: blocks_file_sink
  parameters:
    append: 'False'
    comment: 'MPX crudo a 240 kHz (piloto, L-R, RDS) para analisis en Python'
    file: mpx_240k.f32
    type: float
    unbuffered: 'False'
    vlen: '1'
  states: {coordinate: [860, 380], rotation: 0, state: enabled}
- name: rf_spectrum
  id: qtgui_freq_sink_x
  parameters:
    bw: samp_rate
    comment: 'Espectro de RF antes de demodular'
    fc: '0'
    fftsize: '4096'
    gui_hint: ''
    name: '"Espectro RF"'
    nconnections: '1'
    showports: 'False'
    type: complex
    wintype: window.WIN_BLACKMAN_hARRIS
  states: {coordinate: [420, 400], rotation: 0, state: enabled}
- name: mpx_spectrum
  id: qtgui_freq_sink_x
  parameters:
    bw: mpx_rate
    comment: 'Aqui se ve el piloto de 19 kHz'
    fc: '0'
    fftsize: '4096'
    gui_hint: ''
    name: '"Espectro MPX"'
    nconnections: '1'
    showports: 'False'
    type: float
    wintype: window.WIN_BLACKMAN_hARRIS
  states: {coordinate: [860, 520], rotation: 0, state: enabled}
- name: audio_spectrum
  id: qtgui_freq_sink_x
  parameters:
    bw: audio_rate
    comment: 'Audio demodulado (contenido hasta 15 kHz)'
    fc: '0'
    fftsize: '2048'
    gui_hint: ''
    name: '"Espectro audio"'
    nconnections: '1'
    showports: 'False'
    type: float
    wintype: window.WIN_BLACKMAN_hARRIS
  states: {coordinate: [1260, 440], rotation: 0, state: enabled}
- name: rf_waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    bw: samp_rate
    comment: 'Waterfall de RF'
    fc: '0'
    fftsize: '1024'
    gui_hint: ''
    name: '"Waterfall RF"'
    nconnections: '1'
    showports: 'False'
    type: complex
    wintype: window.WIN_BLACKMAN_hARRIS
  states: {coordinate: [420, 520], rotation: 0, state: enabled}

connections:
- [src, '0', throttle, '0']
- [throttle, '0', channel_lpf, '0']
- [throttle, '0', rf_spectrum, '0']
- [throttle, '0', rf_waterfall, '0']
- [channel_lpf, '0', quad_demod, '0']
- [quad_demod, '0', mpx_sink, '0']
- [quad_demod, '0', mpx_spectrum, '0']
- [quad_demod, '0', deemph, '0']
- [deemph, '0', audio_lpf, '0']
- [audio_lpf, '0', audio_out, '0']
- [audio_lpf, '0', audio_file, '0']
- [audio_lpf, '0', audio_spectrum, '0']

metadata:
  file_format: 1
